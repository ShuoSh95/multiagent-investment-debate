# ==============================================================
#  复制本文件为 .env 并填入你自己的 Key：  cp .env.example .env
#  .env 已在 .gitignore 中，不会被提交到 GitHub。
# ==============================================================

# ==============================================================
# Chat LLM — 驱动 5 位大师 + 交叉质疑 + 研究员总结 + 追问
# ==============================================================
# Supported: deepseek | openai | anthropic | gemini | qwen | zhipu | doubao
LLM_PROVIDER=gemini

# 只填与上面 LLM_PROVIDER 匹配的那一个 Key
GOOGLE_API_KEY=your_gemini_api_key_here
# DEEPSEEK_API_KEY=sk-xxxx
# OPENAI_API_KEY=sk-xxxx
# ANTHROPIC_API_KEY=sk-ant-xxxx
# DASHSCOPE_API_KEY=sk-xxxx         # 通义千问 / 阿里云百炼
# ZHIPU_API_KEY=xxxx.xxxx           # 智谱 GLM
# ARK_API_KEY=xxxx                  # 豆包 / 火山方舟

# ---- 模型分工（可选，留空则用各 Provider 默认）----
# 大师辩论 + 研究员总结 + 追问：深度推理模型
LLM_MODEL=gemini-2.5-pro
# 轻量任务（大师"是否需要补充数据"自评）：快/省模型
LLM_FAST_MODEL=gemini-2.5-flash
# 网络检索（Google grounding）：与上面分开
WEB_SEARCH_MODEL=gemini-2.5-flash

# 大师每轮可按自身分析框架主动发起 Web 检索（1=开启 / 0=关闭）
ENABLE_AGENT_SEARCH=1

# ==============================================================
# Embedding — 仅用于知识库构建 & 检索
# ==============================================================
# local  = BGE-M3 (sentence-transformers, 跑在 Apple MPS, 免费, 推荐)
# openai = text-embedding-3-large (质量更高但消耗 token)
EMBEDDING_PROVIDER=local

# HuggingFace 镜像（中国大陆加速；不需要可删除此行）
HF_ENDPOINT=https://hf-mirror.com

# ==============================================================
# Web Search fallback（非 Gemini 用户可选）
# ==============================================================
# TAVILY_API_KEY=tvly-xxxx          # https://tavily.com 免费 1000 次/月
